    },
    {
      "files": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "hooks/**/*.{ts,tsx}", "styles/**/*.ts"],
      "rules": {
        "local/tokens-only": "error",
        "local/no-inline-svg": "error"
      }
    },
    {
      "files": ["e2e/*.spec.ts"],
      "rules": {
        "local/e2e-tag": "error"
      }
    },
    {
      "files": ["e2e/**/*.ts", "**/*.test.{ts,tsx}", "scripts/*.test.mjs", "*.test.mjs"],
      "rules": {
        "local/no-fixed-wait": "error"
      }
    },
    {
      "files": ["playwright.config.ts", "e2e/**/*.ts"],
      "rules": {
        "local/no-test-retries": "error"
      }
    }
  ],
  "$schema": "./node_modules/oxlint/configuration_schema.json"
}
