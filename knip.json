{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "scripts/*.mjs",
    "src/**/*.test.ts",
    "e2e/**/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "styles/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "components/ui/**"
  ],
  "ignoreDependencies": [
    "tw-animate-css",
    "shadcn",
    "tailwindcss"
  ]
}
