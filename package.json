{
  "name": "personal-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/render-diagrams.mjs",
    "build": "next build",
    "prebuild": "node scripts/render-diagrams.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm format:check && node scripts/lint.mjs",
    "lint:fix": "pnpm format && node scripts/lint.mjs --fix",
    "lint:oxlint": "oxlint --type-aware",
    "lint:eslint": "eslint --cache --cache-strategy content",
    "quality": "knip && jscpd && dpdm --no-warning --no-tree --exit-code circular:1 --transform src/**/*.ts app/**/*.tsx",
    "test": "vitest run",
    "test:changed": "node scripts/test-changed.mjs",
    "ensure-deps": "node scripts/ensure-deps.mjs",
    "ensure-playwright": "node scripts/ensure-playwright.mjs",
    "lint-staged": "lint-staged",
    "check:changed": "node scripts/check-changed.mjs",
    "check": "pnpm ensure-deps && pnpm typecheck && pnpm lint && pnpm quality && pnpm test && pnpm build && pnpm lint:html && pnpm check:links && pnpm check:seo && pnpm check:budgets && pnpm perf && pnpm test:e2e",
    "test:e2e": "pnpm ensure-playwright && playwright test",
    "design:tokens": "node scripts/build-design-tokens.mjs",
    "visual:component": "node scripts/visual-component.mjs",
    "prototype:shots": "node scripts/prototype-shots.mjs",
    "prototype:compare": "node scripts/prototype-compare.mjs",
    "lint:html": "html-validate \"out/**/*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/ubuntu": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.78.0",
    "next": "^16.4.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.23.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "chrome-launcher": "1",
    "dpdm": "^4.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "html-validate": "^10.17.0",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "1.63.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
